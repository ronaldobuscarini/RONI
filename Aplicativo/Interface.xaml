<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RONI Companion" Width="940" Height="710" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#0B151D" Foreground="#EDF5F8" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#203543"/><Setter Property="Foreground" Value="#EDF5F8"/><Setter Property="Padding" Value="17,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D2E2E8"/><Setter Property="Margin" Value="0,9,0,5"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="68" Height="62" CornerRadius="20" Background="#112C33" Margin="0,0,16,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="13" Height="24" CornerRadius="6" Background="#77E8C0" Margin="0,0,9,0"/><Border Width="13" Height="24" CornerRadius="6" Background="#77E8C0"/></StackPanel></Border>
   <StackPanel Grid.Column="1"><TextBlock Text="RONI Companion" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Perto de você, mesmo de longe." Foreground="#93ADB9" Margin="0,4,0,0"/></StackPanel>
   <Border Grid.Column="2" Background="#172B37" CornerRadius="12" Padding="14,9" VerticalAlignment="Center"><TextBlock Name="Connection" Text="●  Aguardando USB" Foreground="#F2C879"/></Border>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Background="#13232F" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="SEU RONI" Foreground="#78E7BF" FontSize="11" FontWeight="Bold"/><TextBlock Name="DeviceTitle" Text="Vamos nos conectar" FontSize="19" Margin="0,12,0,8"/><TextBlock Name="DeviceHelp" Text="Conecte o RONI pela USB de dados. A conexão será procurada automaticamente." TextWrapping="Wrap" Foreground="#ABC0CA" LineHeight="21"/>
     <TextBlock Text="Porta USB" Foreground="#93ADB9" Margin="0,18,0,6"/><ComboBox Name="Ports" Background="#E8F1F4" Foreground="#10212C" Padding="8"/>
     <Button Name="Refresh" Content="Procurar novamente" Margin="0,12,0,0"/>
     <Button Name="Pause" Content="Pausar USB / programar" Margin="0,9,0,0"/>
    </StackPanel></Border>
    <Border Background="#13232F" CornerRadius="18" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="DO SEU JEITO" Foreground="#78E7BF" FontSize="11" FontWeight="Bold"/><CheckBox Name="Sound" Content="Tocar aviso sonoro"/><CheckBox Name="Popup" Content="Mostrar aviso na tela"/><CheckBox Name="Startup" Content="Iniciar com o Windows"/><Button Name="Test" Content="Testar aviso" Margin="0,12,0,0"/></StackPanel></Border>
   </StackPanel>
   <Border Grid.Column="2" Background="#13232F" CornerRadius="18" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="Sua caixa de mensagens" FontSize="21" FontWeight="SemiBold"/><TextBlock Name="Count" Text="0 mensagens" Foreground="#93ADB9" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11"/></Grid>
    <TextBlock Grid.Row="1" Text="O Telegram chega ao RONI. O RONI avisa você pela USB." Foreground="#93ADB9" TextWrapping="Wrap" Margin="0,9,0,20"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Name="Messages"><Border Name="Empty" Padding="26" Background="#0E1C26" CornerRadius="14"><StackPanel><TextBlock Text="Uma mensagem faz companhia." FontSize="19" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Quando uma mensagem chegar, ela ficará aqui. Você pode fechar esta janela: o RONI continua junto ao relógio do Windows." TextWrapping="Wrap" Foreground="#93ADB9" LineHeight="23"/></StackPanel></Border></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0"><Button Name="Clear" Content="Limpar histórico"/><Button Name="Hide" Content="Deixar em segundo plano" Background="#78E7BF" Foreground="#09271F"/></StackPanel>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="USB local • Sem acesso à sua conta do Telegram • Fechar a janela mantém os avisos ativos" Foreground="#7895A4" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,0"/>
 </Grid>
</Window>
